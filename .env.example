# SECURITY WARNING: Never commit real API keys to version control
# These are example placeholders only - replace with your actual keys
# Real keys should be set in your deployment environment

# AI Service Keys (REQUIRED - Get from Google AI Studio)
AI_ASSISTANT_API_KEY=your_ai_assistant_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://logonai.netlify.app

# Email / leads (optional)
RESEND_API_KEY=
TO_EMAIL=logonthepage@gmail.com
THIRD_PARTY_WEBHOOK_URL=
WEBHOOK_HMAC_SECRET=

# Tally form webhook (same values you paste in Tally → Integrations → Webhooks)
TALLY_SIGNING_SECRET=
TALLY_WEBHOOK_HEADER_SECRET=
NEXT_PUBLIC_TALLY_FORM_ID=aQpexW

# Protect admin/ingest endpoints in production
LOGS_INGEST_SECRET=
AI_HEALTH_SECRET=
INTERNAL_API_SECRET=

# Analytics (omit or leave placeholder to disable GTM)
NEXT_PUBLIC_GTM_ID=

# PostHog (project token from https://app.posthog.com/project/settings)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_TOKEN=
# Set to true only if you still want Matomo alongside PostHog
NEXT_PUBLIC_ENABLE_MATOMO=
