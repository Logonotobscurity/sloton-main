# Analytics System Configuration
# Copy this file to .env.local and fill in your values

# Analytics API
ANALYTICS_API_KEY=your-api-key-here
ANALYTICS_API_ENDPOINT=http://localhost:3000/api/events/ingest

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/analytics

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Event Bus (Kafka)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=analytics-system

# Redis Cache
REDIS_URL=redis://localhost:6379

# IP Geolocation (optional)
IPGEOLOCATION_API_KEY=your-ipgeolocation-api-key

# Feature Flags
ANALYTICS_ENABLE_REALTIME_METRICS=true
ANALYTICS_ENABLE_JOURNEY_PATTERNS=true
ANALYTICS_ENABLE_LEAD_SCORING=true
ANALYTICS_ENABLE_AT_RISK_DETECTION=true

# Privacy & Compliance
ANALYTICS_ANONYMIZE_IP=true
ANALYTICS_EVENT_RETENTION_DAYS=365
ANALYTICS_PROFILE_RETENTION_DAYS=730
ANALYTICS_JOURNEY_RETENTION_DAYS=180
